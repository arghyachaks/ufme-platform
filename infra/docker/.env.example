# Copy to infra/docker/.env (never commit .env) and fill in only what you use.
# Docker Compose reads this file automatically for infra/docker/docker-compose.yml.

# Signs evidence packages. Any long random string; empty = a development key.
EVIDENCE_SIGNING_KEY=

# ---- LLM providers (all optional). Without any of these, agents use the local Ollama model.
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
OPENAI_API_VERSION=2024-10-21
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Models agents may use, as one line of JSON. Keys are referenced by NAME (api_key_env), never inlined.
# Models declared here are trusted configuration (status "approved"); models added in the app need a
# Finance Director's approval first. Examples (keep only the ones you use):
# AGENT_MODELS=[{"name":"gpt-4o","provider":"openai","model":"gpt-4o","api_key_env":"OPENAI_API_KEY","price_in":0.0025,"price_out":0.01},{"name":"azure-gpt-4o","provider":"azure_openai","model":"<your-deployment-name>","base_url":"https://<resource>.openai.azure.com/","api_key_env":"AZURE_OPENAI_API_KEY"},{"name":"claude-sonnet","provider":"anthropic","model":"claude-sonnet-4-5","api_key_env":"ANTHROPIC_API_KEY","price_in":0.003,"price_out":0.015},{"name":"gemini-flash","provider":"google_genai","model":"gemini-2.5-flash","api_key_env":"GOOGLE_API_KEY"}]
AGENT_MODELS=

# Which model each agent uses, in fallback order. Roles: default, assist, investigator, researcher.
# AGENT_BINDINGS={"assist":["claude-sonnet","local-default"],"investigator":["gpt-4o","local-default"]}
AGENT_BINDINGS=
